#!/usr/bin/env bash
# Run the smoke tests against the whole test stack, then tear it all down —
# dumping the stack's logs first when it failed.
set -euo pipefail
cd "$(dirname "$0")/.."

compose() { docker compose -f docker-compose.test.yml "$@"; }

cleanup() {
  status=$?
  if [ "$status" -ne 0 ]; then compose logs; fi
  compose down -v --remove-orphans
  exit "$status"
}

# The config cervo computes for one site, handed to the very binary that will
# run it. The stack below exercises the development shape only, so the
# production one — https, a real domain, an ACME contact, and therefore the
# whole tls app — is checked here or nowhere.
config_tree='
import json

from cervo import caddy
from cervo.website.types import Route

sites = [Route(slug="demo", owner_email="owner@example.com")]
print(json.dumps({"apps": caddy.apps(sites)}))
'

validate_config() {
  compose run --rm --no-deps -T "$@" tests python -c "$config_tree" |
    docker run --rm -i docker.io/library/caddy:latest \
      sh -c 'cat > /tmp/apps.json && caddy validate --config /tmp/apps.json'
}

trap cleanup EXIT  # from here on, every exit tears the stack down

compose build

echo "validating the config cervo writes (development)"
validate_config
echo "validating the config cervo writes (production)"
validate_config -e SCHEME=https -e DOMAIN=example.com -e ACME_EMAIL=x@example.com

compose run --rm smoke
