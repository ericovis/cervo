# {{ ansible_managed }} — mode 0600; the SMTP password comes out of
# 1Password on the machine that ran the deploy, never from the repo.
DOMAIN={{ domain }}
SCHEME=https
ACME_EMAIL={{ acme_email }}
EMAIL_HOST={{ email_host }}
EMAIL_PORT={{ email_port }}
EMAIL_USER={{ email_user }}
EMAIL_PASSWORD={{ lookup("pipe", "op read " + (op_smtp_password | quote)) }}
EMAIL_FROM={{ email_from }}
