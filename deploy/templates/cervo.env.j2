# {{ ansible_managed }} — mode 0600; the SMTP password was read out of
# 1Password by bin/deploy on the machine that ran the deploy and handed to
# ansible through the environment — never from the repo.
DOMAIN={{ domain }}
SCHEME=https
ACME_EMAIL={{ acme_email }}
EMAIL_HOST={{ email_host }}
EMAIL_PORT={{ email_port }}
EMAIL_USER={{ email_user }}
EMAIL_PASSWORD={{ lookup("env", "CERVO_SMTP_PASSWORD") }}
EMAIL_FROM={{ email_from }}
