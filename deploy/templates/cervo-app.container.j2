# {{ ansible_managed }}
[Unit]
Description=cervo — the MCP server and public website
Wants=network-online.target
After=network-online.target

[Container]
Image={{ image_repo }}:{{ image_tag }}
# The name is the DNS name on the cervo network: caddy proxies to app:8000.
ContainerName=app
Network=cervo.network
Volume=cervo-data:/mnt/data
EnvironmentFile=/etc/cervo/env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
