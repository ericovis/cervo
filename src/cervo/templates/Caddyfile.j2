# Generated by cervo — do not edit; rewritten on every deployment.
{
	admin 0.0.0.0:2019
{%- if scheme == "https" and acme_email %}
	email {{ acme_email }}
{%- endif %}
}

{# A schemeless address turns on caddy's automatic HTTPS: a certificate per
   hostname, and plain-http requests redirected. http:// keeps development
   certificate-free. Each hosted site registers its owner's email as the
   ACME contact for its certificate; the global email above covers only
   cervo's own hostname. -#}
{% if scheme == "https" %}{{ domain }}{% else %}http://{{ domain }}{% endif %} {
	reverse_proxy {{ mcp_upstream }}
}
{% for site in sites %}

{% if scheme == "https" %}{{ site.slug }}.{{ domain }}{% else %}http://{{ site.slug }}.{{ domain }}{% endif %} {
{%- if scheme == "https" %}
	tls {{ site.owner_email }}
{%- endif %}
	root * {{ data_dir }}/{{ site.slug }}
	file_server
}
{% endfor %}